# Entornos virtuales
venv/
env/
.venv/
ENV/

# Archivos de configuración
*.env

# =========================
# 📓 Jupyter Notebook
# =========================
.ipynb_checkpoints

# =========================
# Dependencias / builds
# =========================
build/
dist/
*.egg-info/
.eggs/

# =========================
# Archivos de datos (opcional)
# =========================
# *.csv
# *.xlsx
# *.xls
# *.parquet

# ⚠️ Si quieres versionar datos, comenta estas líneas

# =========================
